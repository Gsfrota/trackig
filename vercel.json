{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "^/$", "has": [{ "type": "header", "key": "accept", "value": "^\\s*text/markdown\\s*$" }], "dest": "/index.md", "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept", "Cache-Control": "private, no-store" } },
    { "src": "^/index\\.html$", "has": [{ "type": "header", "key": "accept", "value": "^\\s*text/markdown\\s*$" }], "dest": "/index.md", "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept", "Cache-Control": "private, no-store" } },
    { "src": "^/como-funciona\\.html$", "has": [{ "type": "header", "key": "accept", "value": "^\\s*text/markdown\\s*$" }], "dest": "/como-funciona.md", "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept", "Cache-Control": "private, no-store" } },
    { "src": "^/(?:index\\.html|como-funciona\\.html)?$", "headers": { "Vary": "Accept", "Cache-Control": "private, no-store" }, "continue": true },
    { "src": "^/(?:index|como-funciona)\\.md$", "headers": { "Content-Type": "text/markdown; charset=utf-8" }, "continue": true },
    { "handle": "filesystem" }
  ]
}
